# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase project connection.
# Get these from Supabase Dashboard > Settings > API Keys > Legacy anon, service_role API keys.
# The anon key is safe to expose in the browser (public, RLS-protected).
VITE_SUPABASE_URL="https://xxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# ADMIN_PASSWORD: contraseña del login del editor (middleware.ts, HTTP Basic Auth).
# Sin prefijo VITE_ a propósito -- nunca debe llegar al bundle del navegador.
ADMIN_PASSWORD="cambia-esto"

# Recuperación de acceso por correo (?recuperar=1, ver api/recovery/*.ts) -- reemplaza tener que
# correr scripts/reset-admin-password.mjs a mano con la Vercel CLI local.
ADMIN_RECOVERY_EMAIL="tu-correo@gmail.com"
ADMIN_RECOVERY_SECRET="cualquier-string-largo-al-azar"
RESEND_API_KEY="re_..."
# Token de Vercel (Account Settings > Tokens) con permiso sobre este proyecto -- lo usa
# api/recovery/confirm.ts para actualizar ADMIN_PASSWORD y redesplegar sin la CLI. Es el secreto
# más sensible de este flujo: dale el scope más angosto que la UI de Vercel permita.
VERCEL_API_TOKEN="..."
